{
  "name": "brain-dump",
  "version": "0.2.0",
  "private": true,
  "description": "Voice brain dump organized by Gemini, saved to Cloudflare D1.",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply braindump --local",
    "db:migrate:remote": "wrangler d1 migrations apply braindump --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
